{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "jsx": "preserve",
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": ["src/**/*", "electron/**/*", "env.d.ts"],
  "exclude": ["node_modules", "out", "resources"]
}
